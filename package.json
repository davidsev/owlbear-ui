{
  "name": "@davidsev/owlbear-ui",
  "version": "0.1.2",
  "type": "module",
  "repository": {
    "url": "https://github.com/davidsev/owlbear-ui"
  },
  "sideEffects": [
    "dist/index.js",
    "dist/color-picker.js",
    "dist/components/*.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./color-picker": {
      "types": "./dist/types/color-picker.d.ts",
      "import": "./dist/color-picker.js"
    },
    "./components/*": {
      "types": "./dist/types/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./core/*": {
      "types": "./dist/types/core/*.d.ts",
      "import": "./dist/core/*.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "dev": "rm -rf dist && rollup -c -w",
    "check": "biome check src/ test/",
    "check:fix": "biome check --write src/ test/",
    "pretest": "npm run build",
    "test": "web-test-runner",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "lit": "^3.0.0"
  },
  "peerDependencies": {
    "@owlbear-rodeo/sdk": "^3.0.0",
    "vanilla-colorful": "^0.7.0"
  },
  "peerDependenciesMeta": {
    "vanilla-colorful": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/dev-server-rollup": "^0.6.4",
    "@web/test-runner": "^0.20.2",
    "autoprefixer": "^10.4.0",
    "cssnano": "^7.0.0",
    "modern-normalize": "^3.0.0",
    "postcss": "^8.4.0",
    "postcss-import": "^16.0.0",
    "postcss-nesting": "^13.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-serve": "^3.0.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0",
    "vanilla-colorful": "^0.7.2"
  }
}
